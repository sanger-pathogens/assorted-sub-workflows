params {
    bin_seed = 1234
    maxbin2_min_contig = 1000
    concoct_min_contig = 1000
    metabat_min_contig = 1500
    maxbin_markers = 140
    metabat1 = false
    keep_unbinned = false

    // comebin/SemiBin2/MetaCAT - added for the comebin+SemiBin2+MetaCAT+MaxBin2 combo (see binning.nf)
    semibin2_environment = "human_gut"
    // Pre-downloaded locally rather than fetched from GitHub at task runtime - a compute job
    // shouldn't depend on outbound network access/GitHub availability being reproducible.
    metacat_wheel_url = "/data/pam/team162/shared_scratch/software_dbs/metacat_wheel/metacat-1.0.6-py3-none-any.whl"
}

process {
    // comebin needs a GPU - mirrors assorted-sub-workflows/ont_basecalling/ont_basecalling.config's pattern
    withLabel:gpu {
        clusterOptions = { "-M " + task.memory.toMega() + " -R 'select[ngpus>0] span[ptile=1]' -gpu 'num=1:mode=shared:gmem=" + task.memory.toMega() * 2 + "'" }

        queue = { task.time > 48.h ? 'gpu-basement' : 'gpu' }

        containerOptions = {
            workflow.containerEngine == "singularity" ? '--containall --cleanenv --nv':
            ( workflow.containerEngine == "docker" ? '--gpus all': null )
        }
    }
}
