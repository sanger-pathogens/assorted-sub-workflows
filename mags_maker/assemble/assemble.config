params {
    assembly_stats = false
    fastspades = null
    lock_phred = null
    metaspades = true
    megahit = true
    megahit_deterministic = false
    transpose_quast_report = false
    // Publish the assembly handed to binning. Previously false, which meant
    // assemblies existed only inside Nextflow's work/ and died with it. On the
    // PRJNA999635 campaign that made 1,374 already-processed samples impossible
    // to re-bin without re-assembling from reads - the published results tree
    // held only final bins and cleaned reads, no contigs, and work/ was gone.
    // Cost of publishing, measured: 0.23 GB per sample.
    publish_unbinned_contigs = true
}

process{
    withName:METASPADES{
        shell = ['/bin/bash', '-u'] // omitting default option -e (errexit; see https://tldp.org/LDP/abs/html/options.html)
    }
}
