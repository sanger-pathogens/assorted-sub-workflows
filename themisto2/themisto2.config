// Umbrella config for the Themisto2 subworkflows: aggregates each subworkflow's
// own config and holds params shared across all of them.

params {
    // Shared scratch root for GGCAT/SBWT/set-diff temp dirs (each writes under
    // <temp_dir>/<tool>/). null = per-task work dir, fine at species scale. Only set
    // a Lustre path (terabytes free) at background-DB scale; one build per temp_dir.
    temp_dir = null
}

includeConfig "./subworkflows/build_color_index.config"
includeConfig "./subworkflows/setdiff_filter.config"
