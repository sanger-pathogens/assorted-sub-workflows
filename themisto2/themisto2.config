// This is an umbrella config file for the Themisto2 subworkflows.
// It has two jobs:
// 1. Aggregate - pull in each subworkflow's own config to be used in this config
// 2. Provide a place to put any config that is shared across all subworkflows

includeConfig "./subworkflows/build_color_index.config"

// TODO: set_diff_calculations.nf doesn't exist yet -- uncomment once it and its
// config (if it needs one) are actually created, flat in subworkflows/ next to it.
// includeConfig "./subworkflows/set_diff_calculations.config"

// TODO: if set_diff_calculations.nf ends up needing kmer_size too, promote it out
// of build_color_index.config and into this file's own params {} block, so both
// subworkflows share one value instead of two copies that could drift apart.
