params {
    temp_dir = null
    publish_intermediate = false
}

// NB: processes here carry `label 'request_temp'` (GGCAT / SBWT build / Themisto2 build).
// The including pipeline owns that label's config and the `temp_space` param it reads
// (see lsmd nextflow.config: `withLabel: request_temp` -> `rusage[tmp=${params.temp_space}]`).

includeConfig "./subworkflows/build_color_index.config"
includeConfig "./subworkflows/setdiff_filter.config"
