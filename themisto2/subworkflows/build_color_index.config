params {
    // Step 02 - Colour mapping (color_mapping.nf).
    // The per-species metadata file, assembly path and target_groups arrive on
    // BUILD_COLOR_INDEX's samples channel (built by the parent pipeline, e.g. from a
    // run manifest). These are the run-wide settings that stay params:
    assembly_suffix = ".contigs.fasta" // only used when a row's assembly path is a directory
    sample_col      = "Sample_ID"
    group_label     = null // required -- metadata column that groups assemblies into colour sets

    // Shared k-mer size across the GGCAT / SBWT / Themisto2 builds
    color_index_kmer_size = 31

    // Step 07 - lineage-specificity candidate filtering, per lineage in a row's
    // meta.target_groups. candidate_min_freq: within-lineage preset 'core' (>=0.95) /
    // 'relaxed' (>=0.5) / 'catchall' (>0.0), or a bare fraction e.g. "0.8".
    // candidate_min_genome_count is an absolute genome-count floor on top of it, and
    // also the size below which a sister lineage is ignored for specificity_max_outside.
    candidate_min_freq         = "core"
    candidate_min_genome_count = 5
    // Ceiling on the MAX presence fraction across any single other lineage (not a
    // pooled average across all of them -- that hides a unitig concentrated in one
    // sister lineage). null = not applied, i.e. core-only. 0.05 (PAT-3570 default) also
    // requires lineage-specificity: ~87 vs ~3,600 unitigs on the VC 7PET run, and
    // drops the L3b cross-reaction from 98% toward the noise floor.
    specificity_max_outside = 0.05
}