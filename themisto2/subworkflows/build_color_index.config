params {
    assembly_suffix = ".fasta"
    sample_col = null
    group_label = null
    color_index_kmer_size = 31
    candidate_min_freq = "core"
    candidate_min_genome_count = 5
    specificity_max_outside = 0.05
}

// Resource sizing lives directly in each process now (modules/ggcat.nf, modules/themisto2.nf,
// modules/lineage_specificity_filtering.nf), not as withName overrides here -- see those
// files for the measured-peak rationale (GGCAT/Themisto2 build/stats/export scale with
// genome count; the generic mem_* label defaults OOM at species scale, e.g. ~42k
// S. pneumoniae genomes).
