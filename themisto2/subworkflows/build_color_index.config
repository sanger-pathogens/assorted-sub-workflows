params {
    // Step 02 - Colour mapping (color_mapping.nf).
    // The per-species metadata file, assembly path and target_groups arrive on
    // BUILD_COLOR_INDEX's samples channel (built by the parent pipeline, e.g. from a
    // run manifest). These are the run-wide settings that stay params:
    assembly_suffix = ".contigs.fasta" // only used when a row's assembly path is a directory
    sample_col      = "Sample_ID"
    group_label     = null // required -- metadata column that groups assemblies into colour sets

    // Shared k-mer size across the GGCAT / SBWT / Themisto2 builds
    color_index_kmer_size = 31

    // Step 07 - candidate filtering (per requested lineage). A unitig must pass
    // both. candidate_min_freq: preset 'core' (>=0.95) / 'relaxed' (>=0.5) / 'catchall'
    // (>0.0), or a bare fraction e.g. "0.8".
    candidate_min_freq         = "core"
    candidate_min_genome_count = 5  // absolute genome-count floor
}