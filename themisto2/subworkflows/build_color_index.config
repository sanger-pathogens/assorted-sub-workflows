params {
    assembly_suffix = ".fasta"
    sample_col = null
    group_label = null
    color_index_kmer_size = 31
    candidate_min_freq = "core"
    candidate_min_genome_count = 5
    specificity_max_outside = 0.05
}

// Species-wide build resource overrides.
//
// The generic-config label resources (mem_2 -> 2/4/8 GB, mem_4 -> 4/8/16 GB,
// mem_8 -> 8/16/24 GB) were calibrated on a toy dataset. GGCAT and the Themisto
// stats/export steps actually scale with genome / colour count; at ~42k
// S. pneumoniae genomes the label defaults get killed by TERM_MEMLIMIT (exit
// 130), the failure is retried-then-ignored, and the whole downstream chain
// (lineage filter -> candidate branch -> set-diff) is left with no input.
//
// Measured peaks at ~42k genomes: GGCAT ~17 GB (mem_8 label -> OOM at 8 then 16);
// themisto2 stats ~9.6 GB (mem_2 label -> OOM); export similar. Candidate-branch
// variants (GGCAT_CANDIDATE, THEMISTO2_*_CANDIDATE) keep the label defaults --
// their index is tiny.
//
// LINEAGE_SPECIFICITY_FILTER: the streaming pass builds a
// (n_color_sets x relevant_lineages) presence matrix. After the
// lineage_specificity_filter.py memory patch (matrix restricted to
// >= --min-lineage-size lineages + requested targets; outside-max taken a
// column-batch at a time; `dense` pre-sized from export.metadata.txt) the
// measured peak for S. pneumoniae (~42k genomes, 766 labels -> ~150 relevant,
// 3.25M color sets) is ~5 GB. 16 GB base leaves headroom for a larger species /
// more non-singleton lineages; escalation covers the rest. Queue label
// (time_queue_from_normal) is left untouched -- this stays on the normal queue.
process {
    withName: 'GGCAT_SPECIES' {
        memory = { 24.GB * task.attempt }   // 24 / 48 / 72 GB
    }
    withName: 'THEMISTO2_BUILD_SPECIES' {
        memory = { 16.GB * task.attempt }   // 16 / 32 / 48 GB (measured ~12.3 GB at ~42k genomes)
    }
    withName: 'THEMISTO2_STATS_SPECIES' {
        memory = { 16.GB * task.attempt }   // 16 / 32 / 48 GB
    }
    withName: 'THEMISTO2_EXPORT_SPECIES' {
        memory = { 16.GB * task.attempt }   // 16 / 32 / 48 GB
    }
    withName: 'LINEAGE_SPECIFICITY_FILTER' {
        memory = { 16.GB * task.attempt }   // 16 / 32 / 48 GB (was mem_8: 8/16/24 -> OOM at species scale)
    }
}
