params {
    // Step 02 - Colour mapping (color_mapping.nf)

    assembly_input  = null // required: a directory of assemblies, or a txt file listing assembly paths (one per line)
    assembly_suffix = ".contigs.fasta" // only used when assembly_input is a directory
    metadata        = null // required
    sample_col      = "Sample_ID"
    group_label     = null // required
    target_groups   = null // optional: comma-separated labels for per-lineage indexes; unset = species-wide only

    // Shared across GGCAT / SBWT / Themisto2 builds
    kmer_size = 31

    // Step 07 - Candidate index filtering (lineage_index_filtering.nf /
    // core_catchall_filter.py) -- lineage-only, one run per --target_groups lineage.
    // candidate_min_freq: 'core' (>=0.95) / 'relaxed' (>=0.5) / 'catchall' (>0.0)
    // preset, or write your own fraction directly, e.g. "0.8".
    candidate_min_freq         = "core"
    // candidate_min_genome_count: absolute genome-count floor, applied alongside
    // candidate_min_freq (a unitig needs both to be kept).
    candidate_min_genome_count = 5
}

    //TO DO: make abbreviations for params (one-two letters)