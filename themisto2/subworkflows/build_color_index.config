params {
    assembly_suffix = ".fasta"
    sample_col = null
    group_label = null
    color_index_kmer_size = 31
    candidate_min_freq = "core"
    candidate_min_genome_count = 5
    specificity_max_outside = 0.05
}

// Resource sizing lives in each process's cpu_*/mem_* labels (modules/ggcat.nf,
// modules/sbwt.nf, modules/themisto2.nf, modules/lineage_specificity_filtering.nf), not as
// withName overrides here. GGCAT and SBWT_BUILD use cpu_32/mem_64 to match the Themisto2
// README's large-index recipe (-j/-t 32, -m 64); mem_* labels double on each retry, capped
// by params.max_memory.
