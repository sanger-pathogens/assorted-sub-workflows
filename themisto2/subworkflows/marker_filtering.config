params {
    // ATB cross-species check (marker_filtering.nf) -- replaces the old bg_excl/markers
    // sbwt set-diff (bg_index/bg_excl_index/sbwt_diff_low_ram, removed with PAT-3570's
    // move away from sbwt set-diff at species-index scale).
    atb_index            = "/lustre/scratch124/pam/teams/team230/ja40/ATB-species/ATB-species.thm2"
    atb_colour_names     = "/lustre/scratch124/pam/teams/team230/ja40/ATB-species/color_names.txt"

    // Same >=95% within / <=5% outside tolerance lineage_specificity_filter.py already
    // applies one level down (across sister lineages within a species) -- see
    // atb_max_outside default below, deliberately reusing specificity_max_outside rather
    // than a separately-tuned number.
    atb_min_within      = 0.95
    atb_max_outside     = params.specificity_max_outside

    // ATB colours dropped from the max-outside check are per species now: the manifest's
    // atb_exclude_species column (blank = 'unknown') -- see lsmd's manifest_parse.nf.
}

// THEMISTO2_ATB_PSEUDOALIGN's resource sizing lives directly in modules/themisto2.nf, not
// as a withName override here -- see that file for the hugemem rationale. FILTER_ATB_MARKERS
// (modules/filter_atb_markers.nf) needs no override: candidate index is tiny (10s-10,000s
// of unitigs), and it just streams the JSONL doing simple per-marker arithmetic.
