params {
    // ATB cross-species check (marker_filtering.nf) -- replaces the old bg_excl/markers
    // sbwt set-diff (bg_index/bg_excl_index/sbwt_diff_low_ram, removed with PAT-3570's
    // move away from sbwt set-diff at species-index scale).
    atb_index           = "/lustre/scratch124/pam/teams/team230/ja40/ATB-species/ATB-species.thm2"
    atb_color_names     = "/lustre/scratch124/pam/teams/team230/ja40/ATB-species/color_names.txt"

    // Same >=95% within / <=5% outside tolerance lineage_specificity_filter.py already
    // applies one level down (across sister lineages within a species) -- see
    // atb_max_outside default below, deliberately reusing specificity_max_outside rather
    // than a separately-tuned number.
    atb_min_within      = 0.95
    atb_max_outside     = params.specificity_max_outside

    // ATB colours dropped from the max-outside check entirely -- 'unknown' is ATB's
    // catch-all bucket for unassigned/low-confidence genomes.
    atb_exclude_species = ["unknown"]
}

process {
    // ATB-species.thm2 is ~293 GB on disk -- must route to hugemem. Sizing here is a
    // starting point (no measured peak yet, unlike the old bg_excl sbwt-diff sizing);
    // escalates via task.attempt on OOM. Revisit once a real run has a peak_rss.
    withName: 'THEMISTO2_ATB_PSEUDOALIGN' {
        cpus   = 8
        memory = { 350.GB * task.attempt }
        time   = 24.h
        queue  = 'hugemem'
    }

    // Candidate index is tiny (10s-10,000s of unitigs); FILTER_ATB_MARKERS just streams
    // the JSONL and does simple per-marker arithmetic. Default cpu_1/mem_2 labels cover
    // both comfortably -- no override needed.
}
