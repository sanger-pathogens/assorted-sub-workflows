params {
    // Set-difference calculations (setdiff_filter.nf)
    sbwt_diff_low_ram = false  // --low-ram: peak-RAM optimisation, not a correctness fix
    // Default background (ATB) for bg_excl / markers when --bg_excl_index is unset.
    // Must be built at the same --color_index_kmer_size as the rest of the indexes.
    bg_index = "/data/pam/team230/sm71/scratch/gps_project/04_sbwt_kmer_index/ATB/ATB_all.sbwt"
    // Pre-built bg_excl to reuse, skipping the hugemem bg_index diff. null = compute it.
    bg_excl_index = null
}

// Only the DIFFERENCE steps need hugemem. The `sbwt check` integrity checks were
// previously swept into the same block by an over-broad selector and sat PEND
// behind the hugemem backlog for a ~2 min job -- they are split out here and
// sized to route to `normal` (standard profile: memory > 256 GB -> hugemem,
// otherwise by time).
process {
    // bg_excl = background - species_index: minuend is the ~91 GB ATB index.
    // Real-run profile: 900GB/hugemem, -t 4, ~17h (standalone job 769685 peaked
    // ~533 GiB; keep headroom).
    withName: 'SBWT_DIFFERENCE_BG_EXCL' {
        cpus   = 4
        memory = 900.GB
        time   = 48.h
        queue  = 'hugemem'
    }

    // markers = candidate_index - bg_excl: candidate operand is tiny (10s-10,000s
    // of unitigs), so peak RAM is dominated by loading/interleaving the ~85 GiB
    // bg_excl. Measured peak_rss in test_4_vc_7PET_full was ~490 GiB. 600 GiB (x
    // task.attempt) leaves ~20% headroom, schedules far more readily than 900 on
    // a congested hugemem, and escalates to 1200 GiB if it ever does OOM.
    // Still >256 GB so still routes to hugemem under the standard profile.
    withName: 'SBWT_DIFFERENCE_MARKERS' {
        cpus   = 4
        memory = { 600.GB * task.attempt }
        time   = 48.h
        queue  = 'hugemem'
    }

    // Diagnostic k-mer counter (errorStrategy 'ignore'): runs `sbwt check` on the
    // stage's index. For bg_excl_diff that's the ~85 GiB background, so the
    // module's default `mem_2` (2 GB) OOMs and the bg_excl row's n_kmers comes
    // out blank. Size it like SBWT_CHECK_BG_EXCL so the count actually records;
    // <256 GB keeps it on `normal`. (markers_diff's index is tiny -- over-reserves
    // harmlessly for a ~10 s job.)
    withName: 'CHECKPOINT_COUNT_SBWT' {
        cpus   = 4
        memory = 128.GB
        time   = 1.h
    }

    // `sbwt check` on an ATB-scale index (~85 GiB): mmaps the whole index into
    // RAM (measured ~82 GiB, ~2-5 min). Real memory, but nowhere near hugemem.
    // SBWT_CHECK_BG_EXCL checks `background - species`, only marginally smaller
    // than the background itself, so it is sized like SBWT_CHECK_BACKGROUND.
    withName: 'SBWT_CHECK_BACKGROUND|SBWT_CHECK_BG_EXCL' {
        cpus   = 4
        memory = 120.GB
        time   = 1.h
    }

    // `sbwt check` on a markers index (candidate minus bg_excl -> small):
    // sub-second, a few GB.
    withName: 'SBWT_CHECK_MARKERS' {
        cpus   = 4
        memory = 8.GB
        time   = 30.m
    }
}
