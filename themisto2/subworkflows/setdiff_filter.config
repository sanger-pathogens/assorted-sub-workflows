params {
    // Step 08 - Set-difference calculations (set_diff_calculations.nf)
    // sbwt difference's --low-ram flag -- a peak-RAM optimization, not a
    // correctness fix (08_set_difference_filtering.md ruled it out as a fix
    // for the corruption bug), but worth exposing since real diffs have
    // needed very large memory allocations.
    sbwt_diff_low_ram = false
}
