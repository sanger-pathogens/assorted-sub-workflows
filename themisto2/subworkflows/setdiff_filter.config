params {
    // Step 08 - Set-difference calculations (set_diff_calculations.nf)
    // sbwt difference's --low-ram flag -- a peak-RAM optimization, not a
    // correctness fix (08_set_difference_filtering.md ruled it out as a fix
    // for the corruption bug), but worth exposing since real diffs have
    // needed very large memory allocations.
    sbwt_diff_low_ram = false
    // Default background index (ATB) that bg_excl (C)/markers (G) are diffed against
    // when --bg_excl_index isn't set. Must be built at the same --kmer_size as the
    // rest of this pipeline's indexes.
    bg_index = "/data/pam/team230/sm71/scratch/gps_project/04_sbwt_kmer_index/ATB/ATB_all.sbwt"
    // Path to an already-built bg_excl (step08 "C", background - species_index)
    // SBWT index to reuse directly -- skips re-running the hugemem-scale bg_index
    // diff. Leave empty to compute bg_excl from bg_index instead.
    bg_excl_index = ""
}
