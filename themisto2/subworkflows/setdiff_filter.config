params {
    // Step 08 - set-difference calculations (setdiff_filter.nf)
    sbwt_diff_low_ram = false  // --low-ram: peak-RAM optimisation, not a correctness fix
    // Default background (ATB) for bg_excl (C)/markers (G) when --bg_excl_index is unset.
    // Must be built at the same --color_index_kmer_size as the rest of the indexes.
    bg_index = "/data/pam/team230/sm71/scratch/gps_project/04_sbwt_kmer_index/ATB/ATB_all.sbwt"
    // Pre-built bg_excl to reuse, skipping the hugemem bg_index diff. null = compute it.
    bg_excl_index = null
}

// MARKERS/BG_EXCL (+ SBWT_CHECK_BACKGROUND) diff against ATB-scale data -- real-run
// profile: 900GB/hugemem, -t 4, ~17h. See 08_set_difference_filtering.md.
process {
    withName: 'SBWT_(DIFFERENCE|CHECK)_(MARKERS|BG_EXCL)|SBWT_CHECK_BACKGROUND' {
        cpus   = 4
        memory = 900.GB
        time   = 48.h
        queue  = 'hugemem'
    }
}
