singularity {
    envWhitelist = "PIPELINE_EVENTS_DATABASE_HOSTS,PIPELINE_EVENTS_DATABASE_USER,PIPELINE_EVENTS_DATABASE_PASSWORD,PIPELINE_EVENTS_DATABASE_DBNAME"
}
params {
    pipeline_events_track = false
    pipeline_events_follow_links = false
    track_batch_metadata = true
    testing = false
    pipeline_events_container_base = 'gitlab-registry.internal.sanger.ac.uk/sanger-pathogens/pipeline-event-api/pipeline-event-api:v1.0.9'
    pipeline_events_container = params.testing ? "${params.pipeline_events_container_base}-rc1" : "${params.pipeline_events_container_base}"}
}