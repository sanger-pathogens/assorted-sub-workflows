{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["/tmp"],
    "allow": ["WebFetch(domain:sanger.ac.uk)"]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp"],
      "allowWrite": ["/tmp"]
    },
    "network": {
      "allowedDomains": ["sanger.ac.uk"]
    }
  }
}
