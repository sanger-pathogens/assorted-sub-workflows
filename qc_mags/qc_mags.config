params {
    checkm2_db = "/data/pam/software/checkm2_db/uniref100.KO.1.dmnd"
    gunc_db = "/data/pam/software/gunc/GTDB/gunc_db_gtdb95.dmnd"
    mdmcleaner_db = "/data/pam/software/mdmcleaner/v1"
    gtdbtk_db = "/data/pam/software/GTDBTk/release232_skani040"
    fast_taxonomy = true
    fasta_ext = "fa"
    min_contig = 1000
    report_config = "${projectDir}/assorted-sub-workflows/qc_mags/assets/report_config.json"
    autoqc_config = null
    skip_raw_reports = false
    temp_file_storage = "/tmp"
    temp_space = "30GB"
    batch_size = 0
    publish_mdmcleaner = false

    genome_type = "mag"
    // optional TSV (columns genome, genome_type) typing each genome for MIXED runs; genome = input
    // genome name without extension. Genomes not listed use genome_type above.
    genome_types = null
}
    

process {
    withName:'GTDBTK|MDMCLEANER' {
        maxForks = 10
        clusterOptions = "-R 'select[tmp>${params.temp_space}]'"
    }
}