params {
    run_qc = true
    host_removal = "auto" // "auto": every sample except reads from iRODS, "all" or "none"
    host_bowtie2_index = "/lustre/scratch125/core/sciops_repository/references/Homo_sapiens/T2T-CHM13v2.0/all/bowtie2/T2T-CHM13v2.0.fa"

    // Trimmomatic defaults (SLIDINGWINDOW:4:20 CROP:151 MINLEN:70); -Q: no extra quality filter, as Trimmomatic had none
    fastp_options = "--cut_right --cut_right_window_size 4 --cut_right_mean_quality 20 --max_len1 151 --max_len2 151 --length_required 70 -Q -z 4"
    fastp_trim_poly_g = true // force polyG tail trimming (-g); false disables it (-G)
    save_individual_fastp_reports = true

    // output files
    publish_clean_reads = true // publish QC'd fastqs into your outdir parameter
    preprocessing_output_dir = "preprocessed_fastqs" // output directory for QC'd reads
    preproc_read_suffix = "_preprocessed" // suffix for QC'd reads file basename (e.g. sampleID_preprocessed_1.fastq.gz)

    // -- sylph --//
    sylph_profile = true
    sylph_db = "/data/pam/software/sylph/gtdb-r232-c200-dbv1/gtdb-r232-c200-dbv1.syldb"
    sylph_tax_metadata = "/data/pam/software/sylph-tax/v1/gtdb_r232_metadata.tsv"
    sylph_k = 31
    sylph_profile_options = "-u"
    sylph_profile_batch_size = 200 // sketches per sylph profile job, so the database is loaded once per batch
    save_sylph_sketches = false

    // -- multiqc --//
    qc_multiqc_report = true // one report of bowtie2, fastp and sylph-tax results across all samples, in <outdir>/multiqc
    qc_report_name = "qc_report" // report is named <date>-<qc_report_name>.html
    qc_multiqc_config = "${projectDir}/assorted-sub-workflows/qc/assets/multiqc_config.yaml"
}
